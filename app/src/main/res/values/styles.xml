<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Novel Studio "Calm": quiet dark app theme; platform AlertDialogs pick up GlassAlertDialog.
         The window itself is edge-to-edge; MainActivity applies system-bar insets to its surfaces. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorBackground">#FF09090B</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#FF9AA0FF</item>
        <item name="android:alertDialogTheme">@style/GlassAlertDialog</item>
    </style>

    <style name="GlassAlertDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_dialog_bg</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:textColorPrimary">#FFF1F1F3</item>
        <item name="android:textColorSecondary">#FFA0A0AA</item>
        <item name="android:textColorHint">#FF6E6E77</item>
        <item name="android:colorAccent">#FF9AA0FF</item>
    </style>

    <!-- Sibling screens (ReaderActivity, JapaneseMangaEngineActivity) share the same surface. -->
    <style name="CalmTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorBackground">#FF09090B</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">#FF9AA0FF</item>
        <item name="android:alertDialogTheme">@style/GlassAlertDialog</item>
    </style>
</resources>
